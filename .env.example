# Desktop gateway (single-user / LAN share)
# Data directory for SQLite DB, master key file and browser profiles.
# The Electron shell sets this to its userData automatically; for standalone
# `npm run dev` it defaults to the current working directory.
GATEWAY_DATA_DIR=

# Server binding
PORT=3000
# HOST is derived from SHARE_LAN when unset: 127.0.0.1 (private) or 0.0.0.0 (LAN).
# SHARE_LAN=1 exposes the /v1 API to your local network.
SHARE_LAN=0

# Optional base URL for external access (leave empty for relative URLs default)
PUBLIC_BASE_URL=

# Optional CORS allowlist for the /v1 API (comma-separated origins).
# Leave empty for same-origin + LAN clients (wildcard for non-browser SDKs).
CORS_ORIGINS=

# Master encryption key (64-char hex). If unset, the app generates and stores
# a persistent key file (.masterkey) inside GATEWAY_DATA_DIR on first run.
MASTER_ENCRYPTION_KEY=

# Upstream & Gateway Settings
LOG_LEVEL=info
REQUEST_TIMEOUT=60000
MAX_UPSTREAM_ATTEMPTS=2
