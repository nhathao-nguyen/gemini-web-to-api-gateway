# Server Binding (listen on all LAN interfaces)
PORT=3000
HOST=0.0.0.0

# Optional base URL for external access (leave empty for relative URLs default)
PUBLIC_BASE_URL=

# Configurable CORS allowlist for Admin API (comma-separated origins, leave empty for same-origin)
CORS_ORIGINS=

# Master encryption key (32 bytes hex or string) used for AES-256-GCM cookie encryption
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Cache connection strings (supports SQLite/in-memory fallback when not set)
DATABASE_URL=
REDIS_URL=

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_secret_key_change_me

# Upstream & Gateway Settings
LOG_LEVEL=info
REQUEST_TIMEOUT=60000
MAX_UPSTREAM_ATTEMPTS=2
